# Google Places API Configuration
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Yelp API Configuration (alternative review source)
YELP_API_KEY=your_yelp_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Review Update Schedule (cron format)
REVIEW_UPDATE_SCHEDULE=0 */6 * * * # Every 6 hours

# Maximum reviews to fetch per store
MAX_REVIEWS_PER_STORE=10

# Enable/disable automatic review fetching
AUTO_FETCH_REVIEWS=true 